
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointdoacai",
  "main": "./worker.js",
  "compatibility_date": "2026-10-26",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
